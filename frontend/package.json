{
  "name": "ya-gpt-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "predev": "npm run wasm:build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run wasm:build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run wasm:build",
    "test": "node --test src/model/*.test.ts src/*.test.ts src/runtime/*.test.ts",
    "test:browser": "playwright test",
    "test:gpu": "playwright test --config playwright.gpu.config.ts",
    "wasm:build": "node scripts/build-wasm.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^2.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  }
}
